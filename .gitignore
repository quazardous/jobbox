__pycache__/
*.pyc

# LOCAL PLUMBING, never shared. These belong to whoever's machine this
# is — the ticket tracker's project config, the MCP servers a session
# connects to, and the harness settings for this checkout. They stay on
# disk; they simply do not travel in the repository.
#
# `.claude/settings.json` is what `jbx init` wires: tracking it would
# ship one machine's hooks to everybody who clones. `.jbx.yaml` is the
# same call made for the project's settings — `jbx init` writes it
# commented, and it stays a local decision rather than a shared one.
.aiball.yaml
.aiball-session_id
.mcp.json
.claude/
.jbx.yaml

# The Rust build tree.
target/
