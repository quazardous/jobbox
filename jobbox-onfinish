#!/bin/sh
# `tsp` RUNS THIS WHEN A JOB ENDS, never a human.
#
# It receives four arguments, in this order and with no options:
# `jobid errorlevel outputfile command`. `TS_ONFINISH` uses execlp, so
# this file must be executable and named absolutely — `jobbox.py` takes
# care of that when it sets the variable.
#
# A SHIM RATHER THAN A SECOND PROGRAM: the logic lives in the hidden
# `onfinish` verb, with the rest. Two copies of one gesture drift at the
# first edit of either.
exec python3 "$(dirname "$0")/jobbox.py" onfinish "$@"
